{
  "name": "careloop-core-codes",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone CareLoop core application",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
